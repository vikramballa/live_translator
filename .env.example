# Copy to .env (`bun run setup` does this for you). Never commit .env.

# --- Postgres (local, no Docker) ---
# 5432 is Postgres's default port; change it if yours runs elsewhere.
DATABASE_URL=postgres://YOUR_USER@127.0.0.1:5432/live_translator

# --- LiveKit (local binary, infra/livekit/livekit.dev.yaml). setup.ts generates the key/secret. ---
LIVEKIT_URL=ws://127.0.0.1:7880
# What browsers use to reach LiveKit. In production: wss://rtc.your-domain
LIVEKIT_PUBLIC_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=change-me-key
LIVEKIT_API_SECRET=change-me-secret
# Optional: the Mac's LAN IP, so phones on the same Wi-Fi can join (needs HTTPS for the mic).
# LIVEKIT_NODE_IP=192.168.1.20

# --- API ---
HOST=127.0.0.1
PORT=3000
ROOM_TTL_HOURS=24
# Production behind Caddy: 1 = rate-limit by the client IP Caddy appends to
# X-Forwarded-For. Leave unset when nothing sits in front of the API.
# TRUST_PROXY=1

# --- Translator agent (Python) ---
AGENT_URL=http://127.0.0.1:8765
AGENT_HOST=127.0.0.1
AGENT_PORT=8765
AGENT_SHARED_SECRET=change-me
# m4-local (Apple silicon default) or contabo-cpu (what the server runs)
# PROFILE=contabo-cpu
MODEL_THREADS=4
INFERENCE_WORKERS=2
# 1 = load all models at start-up (slower start, no first-call delay)
PRELOAD_MODELS=0
